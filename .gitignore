cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
koji-backend/venv/

# Environment files
.env
*.env
koji-backend/.env

# ML models - too large for GitHub
ml_models/
koji-backend/ml_models/

# FastAPI / Python cache
.pytest_cache/
.mypy_cache/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
koji_frontend/build/
koji_frontend/.dart_tool/

# iOS / macOS
Pods/
ios/Pods/
koji_frontend/ios/Pods/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/

# Android
.gradle/
android/.gradle/
koji_frontend/android/.gradle/

# IDE
.idea/
.vscode/
*.iml

# OS files
.DS_Store
EOF

# Python virtual environments
venv/
.venv/
koji-backend/venv/

# Environment files
.env
*.env
koji-backend/.env

# Local ML models
ml_models/
**/ml_models/

# Flutter generated/cache files
.dart_tool/
**/.dart_tool/
build/
**/build/

# iOS CocoaPods generated folder
Pods/
**/Pods/

# macOS / IDE
.DS_Store
.idea/
.vscode/
*.iml