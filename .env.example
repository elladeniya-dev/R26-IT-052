# Copy this file to .env and fill in real values. Never commit the real .env.

# Required — Postgres connection string (Neon or any Postgres host).
# Used by app/core/database.py (API) and every app/pipeline/ script.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional — only needed if you pass --use-gemini to
# app/pipeline/ingest_garments_etl.py (an opt-in refinement step; the
# default free local taxonomy mapper does not require this) or if
# trend-data-collector's Tier 3 Gemini AI extraction is enabled.
GEMINI_API_KEY=""
