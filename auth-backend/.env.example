DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fashion_assistant

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_IOS_CLIENT_ID=

JWT_SECRET_KEY=YOUR_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local development only: lets the app skip Google sign-in via
# POST /auth/dev-login. Leave false/unset to use real Google sign-in.
# The server refuses to start with this on when deployed on Render.
DEV_AUTH_BYPASS=true

